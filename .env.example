# Copy to .env.local and adjust.
# Base URL of the NestJS backend (backend/), including its global /api prefix.
NEXT_PUBLIC_API_URL=http://localhost:3003/api

# ─── Server-only: image engines for Drape (src/lib/server/image-engine.ts) ───
# Try-on, twin, poses, makeup and text-to-look run on the first engine in
# IMAGE_ENGINES that has a key; the next one takes over if it fails.
IMAGE_ENGINES=replicate,gemini,openai,openrouter

# Replicate: task-specific models (IDM-VTON try-on, FLUX Kontext edits) and the
# only engine for "Make it move" video. https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=

# Gemini image editing (gemini-2.5-flash-image). Needs billing enabled — the
# free tier has no image-output quota.
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image

# OpenAI image edits (gpt-image-1). Needs API credits.
OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-1

# OpenRouter image models (paid; free-tier keys can't generate images).
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# Legal entity shown in the footer copyright (e.g. "Threadflank Technologies Pvt Ltd").
NEXT_PUBLIC_LEGAL_ENTITY=
